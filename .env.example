# Copier ce fichier vers .env puis renseigner les valeurs réelles.

# Fournisseur et modèle LLM (voir langchain.chat_models.init_chat_model —
# compatible OpenRouter et tout provider géré par LangChain).
LLM_PROVIDER=openrouter
LLM_MODEL=
LLM_API_TOKEN=

# Optionnel — adresse d'écoute de `orientia-app` (défaut : 127.0.0.1:8000).
# API_HOST=127.0.0.1
# API_PORT=8000
